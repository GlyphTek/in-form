# Copy to .env (loaded by your process manager or `node --env-file=.env`)
PORT=3000
HOST=127.0.0.1
LOG_LEVEL=info
# SQLite file; point this at a persistent volume in production (e.g. /data/inform.db)
DATABASE_PATH=./data/inform.db

# Set to true behind Fly.io / nginx so rate limits use real client IPs
TRUST_PROXY=false
RATE_LIMIT_PER_MINUTE=120
GENERATE_RATE_LIMIT_PER_MINUTE=12

# --- Authentication (required) -------------------------------------------------
# One shared passphrase for the single account. 12+ characters. The server
# refuses to start without it, so a deployed instance is never left open.
INFORM_PASSWORD=change-me-to-a-long-passphrase
# For local development only, instead of a password: INFORM_AUTH=off
# (every request acts as the owner; never use on a network-facing server)
INFORM_USER_EMAIL=owner@in-form.local
SESSION_DAYS=30
LOGIN_RATE_LIMIT_PER_MINUTE=8
# Only needed if a reverse proxy rewrites the Host header (comma separated):
# ALLOWED_ORIGINS=https://inform.example.com
